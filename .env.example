# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Production wiring (used by src/services/*) ---

# Replicate API token. NEVER expose to the client - only used by the Express
# server in `server/index.ts`. Required to swap the mock generator for the
# real /api/predict pipeline.
REPLICATE_API_TOKEN=""

# Replicate model version (e.g. interior staging model). Picked by the server.
REPLICATE_MODEL_VERSION=""

# Supabase project URL. The server reads SUPABASE_URL (preferred); falls back
# to VITE_SUPABASE_URL so a single value works for both layers in dev.
SUPABASE_URL=""
VITE_SUPABASE_URL=""

# Public anon key (safe for client). Not strictly needed today because the
# browser never talks to Supabase directly - the server is the gateway.
VITE_SUPABASE_ANON_KEY=""

# Server-only service role key. Bypasses RLS. NEVER ship to the browser.
# Required for production. If missing, the backend falls back to an in-memory
# store that mirrors the same atomicity / idempotency semantics for dev.
SUPABASE_SERVICE_ROLE_KEY=""

# Telegram bot identity (used to build referral links, exposed to client).
VITE_TG_BOT_USERNAME="AiStagingBot"
VITE_TG_APP_SHORT_NAME="app"

# Telegram Bot API token. SERVER-ONLY. Required for Stars billing
# (createInvoiceLink, answerPreCheckoutQuery). Get it from @BotFather.
TELEGRAM_BOT_TOKEN=""

# Random string shared with Telegram via setWebhook(secret_token=...).
# Used to verify inbound webhook calls in /api/billing/webhook.
TELEGRAM_WEBHOOK_SECRET=""

# Set to 'true' to make the frontend call /api/predict on the Express
# backend instead of the client-side mock. Useful for end-to-end QA
# of the prompt pipeline before Replicate is fully wired.
VITE_USE_BACKEND="false"
